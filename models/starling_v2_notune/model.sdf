<?xml version="1.0"?>

<sdf version="1.10">

  <model name="starling_v2_notune">

    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="base_link">

      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.280</mass> <!--4.10-->
        <inertia>
          <ixx>0.006</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.006</iyy>
          <iyz>0</iyz>
          <izz>0.010</izz>
        </inertia>
      </inertial>

      <collision name="base_link_collision">
        <pose>0 0 0.018 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.11</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_link_visual">
        <pose>0 0 0 1.57079632679 0 1.57079632679</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>meshes/Starling_base.obj</uri>
          </mesh>
        </geometry>
        <cast_shadows>false</cast_shadows>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <enable_orientation>true</enable_orientation>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0005</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.0002</bias_stddev>
                <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
                <precision>0.00001</precision>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0005</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.0002</bias_stddev>
                <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
                <precision>0.00001</precision>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0005</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.0002</bias_stddev>
                <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
                <precision>0.00001</precision>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.003</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
                <precision>0.001</precision>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.003</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
                <precision>0.001</precision>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.003</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.0</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
                <precision>0.001</precision>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>

      <sensor name="IMX412_front" type="camera">
        <pose>0.07 0.006 0.002 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>5</update_rate>
        <camera>
          <!-- MSU-M0107/M0161 (Sony Starvis IMX412, 2.7 mm M12 lens): real FOV is
               H 120.4 deg, V 93.5 deg, D 146 deg (docs.modalai.com/M0161).
               NOTE the datasheet's "Fov(DxHxV)" header is mis-ordered - the values are
               listed H, V, D. This field previously held 1.632 rad, which is the VERTICAL
               93.5 deg, so the sim camera was far too narrow.
               The real lens is a fisheye; Gazebo renders rectilinear, so only one axis can
               match. Horizontal is matched here, which makes the rendered vertical 105.3
               deg rather than the true 93.5. The intrinsics below are derived from this
               horizontal_fov so the two blocks agree - they are NOT a measured calibration
               (ModalAI publishes none). -->
          <horizontal_fov>2.1014</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>1161</fx>
              <fy>1161</fy>
              <cx>2028</cx>
              <cy>1520</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>4056</width>
            <height>3040</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="AR0144_front" type="camera">
        <pose>0.07 0.006 0.010 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>1</update_rate>
        <camera>
          <horizontal_fov>2.303</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>605</fx>
              <fy>604</fy>
              <cx>640</cx>
              <cy>400</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>1280</width>
            <height>800</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

       <sensor name="AR0144_back" type="camera">
        <pose>-0.062 -0.010 0.016 0 0 3.14159265</pose>
        <always_on>false</always_on>
        <update_rate>1</update_rate>
        <camera>
          <horizontal_fov>2.303</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>605</fx>
              <fy>604</fy>
              <cx>640</cx>
              <cy>400</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>1280</width>
            <height>800</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="AR0144_down" type="camera">
        <pose>-0.057 0.011 -0.009 0 1.571 -1.571</pose>
        <always_on>false</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>2.303</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>605</fx>
              <fy>604</fy>
              <cx>640</cx>
              <cy>400</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>1280</width>
            <height>800</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="pmd_flexx2_tof" type="depth_camera">
        <pose>0.07 -0.0095 0.016 0 0 0</pose> <!-- Adjust position and orientation as needed -->
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <camera>
          <!-- 1.85 rad = 106 deg horizontal, per the M0178 datasheet. Vertical (86 deg real)
               and diagonal are not settable: gz derives them from this and the 4:3 aspect. -->
          <horizontal_fov>1.85</horizontal_fov>
          <image>
            <width>240</width>
            <height>180</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
          <!-- Depth noise, off. Both fields 0 => gz builds no noise model at all, so this
               costs nothing. The datasheet gives no figure (depth resolution "TBD"); ~1% of
               range is typical, so try stddev 0.02 (m). Note gz applies one constant stddev,
               it does not scale with range, and keep it well under truncation_distance
               (0.40 m in common_params.py) or surfaces stop fusing. -->
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.0</stddev>
          </noise>
        </camera>
        <visualize>true</visualize>
      </sensor>

      <sensor name="VL53L1X_down" type="gpu_lidar">
        <pose>-0.057 -0.011 -0.009 0 1.571 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>100</samples>
              <resolution>1</resolution>
              <min_angle>-0.5</min_angle>
              <max_angle>0.5</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.001</min>
            <max>4</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
      </sensor>

    </link>

    <link name="rotor_1">

      <pose>-0.066 0.088 0.01470 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.13545e-05</iyy>
          <iyz>0</iyz>
          <izz>8.22545e-05</izz>
        </inertia>
      </inertial>

      <collision name="rotor_1_collision">
