<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor><authoring_tool>obj_to_dae.py</authoring_tool></contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="alu_dark-fx">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission><color>0 0 0 1</color></emission>
            <ambient><color>0.4000 0.4200 0.4500 1.0000</color></ambient>
            <diffuse><color>0.5500 0.5700 0.6000 1.0000</color></diffuse>
            <specular><color>0.3500 0.3500 0.3500 1.0000</color></specular>
            <shininess><float>40.0</float></shininess>
            <index_of_refraction><float>1.0</float></index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="alu_dark-mat" name="alu_dark"><instance_effect url="#alu_dark-fx"/></material>
  </library_materials>
  <library_geometries>
    <geometry id="alu_dark-geo" name="alu_dark">
      <mesh>
      <source id="alu_dark-pos">
        <float_array id="alu_dark-pos-array" count="48">-0.050000 -0.195000 3.517770 0.050000 -0.195000 3.517770 0.050000 -0.145000 3.517770 -0.050000 -0.145000 3.517770 -0.050000 -0.195000 3.577770 0.050000 -0.195000 3.577770 0.050000 -0.145000 3.577770 -0.050000 -0.145000 3.577770 -0.050000 0.145000 3.517770 0.050000 0.145000 3.517770 0.050000 0.195000 3.517770 -0.050000 0.195000 3.517770 -0.050000 0.145000 3.577770 0.050000 0.145000 3.577770 0.050000 0.195000 3.577770 -0.050000 0.195000 3.577770</float_array>
        <technique_common>
          <accessor source="#alu_dark-pos-array" count="16" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor>
        </technique_common>
      </source>
      <source id="alu_dark-nrm">
        <float_array id="alu_dark-nrm-array" count="72">0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 -0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 1.000000 0.000000 0.000000 1.000000 0.000000 0.000000 0.000000 1.000000 0.000000 0.000000 1.000000 -0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.000000</float_array>
        <technique_common>
          <accessor source="#alu_dark-nrm-array" count="24" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor>
        </technique_common>
      </source>
      <vertices id="alu_dark-vtx">
        <input semantic="POSITION" source="#alu_dark-pos"/>
      </vertices>
      <triangles material="alu_dark-sym" count="24">
        <input semantic="VERTEX" source="#alu_dark-vtx" offset="0"/>
        <input semantic="NORMAL" source="#alu_dark-nrm" offset="1"/>
        <p>0 0 2 0 1 0 0 1 3 1 2 1 4 2 5 2 6 2 4 3 6 3 7 3 0 4 1 4 5 4 0 5 5 5 4 5 1 6 2 6 6 6 1 7 6 7 5 7 2 8 3 8 7 8 2 9 7 9 6 9 3 10 0 10 4 10 3 11 4 11 7 11 8 12 10 12 9 12 8 13 11 13 10 13 12 14 13 14 14 14 12 15 14 15 15 15 8 16 9 16 13 16 8 17 13 17 12 17 9 18 10 18 14 18 9 19 14 19 13 19 10 20 11 20 15 20 10 21 15 21 14 21 11 22 8 22 12 22 11 23 12 23 15 23</p>
      </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
        <node id="alu_dark-node" name="alu_dark" type="NODE">
          <instance_geometry url="#alu_dark-geo">
            <bind_material><technique_common>
              <instance_material symbol="alu_dark-sym" target="#alu_dark-mat"/>
            </technique_common></bind_material>
          </instance_geometry>
        </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
