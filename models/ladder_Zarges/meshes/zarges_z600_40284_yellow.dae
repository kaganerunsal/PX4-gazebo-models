<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor><authoring_tool>obj_to_dae.py</authoring_tool></contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="yellow-fx">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission><color>0 0 0 1</color></emission>
            <ambient><color>0.4500 0.4000 0.0500 1.0000</color></ambient>
            <diffuse><color>0.9000 0.8000 0.1000 1.0000</color></diffuse>
            <specular><color>0.1500 0.1500 0.1500 1.0000</color></specular>
            <shininess><float>40.0</float></shininess>
            <index_of_refraction><float>1.0</float></index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="yellow-mat" name="yellow"><instance_effect url="#yellow-fx"/></material>
  </library_materials>
  <library_geometries>
    <geometry id="yellow-geo" name="yellow">
      <mesh>
      <source id="yellow-pos">
        <float_array id="yellow-pos-array" count="24">-0.340040 0.190000 2.064790 -0.338100 0.190000 2.064310 -0.338100 0.205000 2.064310 -0.340040 0.205000 2.064790 -0.267470 0.190000 2.355880 -0.265520 0.190000 2.355400 -0.265520 0.205000 2.355400 -0.267470 0.205000 2.355880</float_array>
        <technique_common>
          <accessor source="#yellow-pos-array" count="8" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor>
        </technique_common>
      </source>
      <source id="yellow-nrm">
        <float_array id="yellow-nrm-array" count="36">-0.240180 0.000000 -0.970728 -0.240180 0.000000 -0.970728 0.239019 0.000000 0.971015 0.239019 -0.000000 0.971015 0.000000 -1.000000 0.000000 0.000000 -1.000000 0.000000 0.970293 0.000000 -0.241932 0.970293 0.000000 -0.241932 0.000000 1.000000 -0.000000 0.000000 1.000000 0.000000 -0.970301 0.000000 0.241900 -0.970301 0.000000 0.241900</float_array>
        <technique_common>
          <accessor source="#yellow-nrm-array" count="12" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor>
        </technique_common>
      </source>
      <vertices id="yellow-vtx">
        <input semantic="POSITION" source="#yellow-pos"/>
      </vertices>
      <triangles material="yellow-sym" count="12">
        <input semantic="VERTEX" source="#yellow-vtx" offset="0"/>
        <input semantic="NORMAL" source="#yellow-nrm" offset="1"/>
        <p>0 0 2 0 1 0 0 1 3 1 2 1 4 2 5 2 6 2 4 3 6 3 7 3 0 4 1 4 5 4 0 5 5 5 4 5 1 6 2 6 6 6 1 7 6 7 5 7 2 8 3 8 7 8 2 9 7 9 6 9 3 10 0 10 4 10 3 11 4 11 7 11</p>
      </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
        <node id="yellow-node" name="yellow" type="NODE">
          <instance_geometry url="#yellow-geo">
            <bind_material><technique_common>
              <instance_material symbol="yellow-sym" target="#yellow-mat"/>
            </technique_common></bind_material>
          </instance_geometry>
        </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
